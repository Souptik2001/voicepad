# Exact browser origin (no path or trailing slash).
# HTTP is allowed only on loopback. Remote access requires HTTPS + a private network.
VOICEPAD_PUBLIC_ORIGIN=http://localhost:8791
VOICEPAD_PORT=8791
# Host path, relative to this checkout or absolute. Must already exist.
VOICEPAD_DATA_DIR=./data
# scripts/setup.sh fills these with your id -u / id -g.
VOICEPAD_UID=1000
VOICEPAD_GID=1000
